# ============================================================
# Seedlist Warmup Service — environment template
#
# Core / shared — COPY THESE VALUES VERBATIM from
# maxify-proj/backend/.env. This project reads the SAME
# Supabase `auto_responder_mailboxes` table and must decrypt
# the SAME app_password values, so these must match exactly
# (do not regenerate/rotate).
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
ENCRYPTION_KEY=

# ============================================================
# Tuning (optional — code has defaults if unset)
# ============================================================
SEEDLIST_WORKER_CONCURRENCY=
PUPPETEER_PAGE_POOL_SIZE=
SEEDLIST_MAILBOX_TIMEOUT_MS=

# ============================================================
# Per-platform cron enable flags ('true' to enable, anything
# else/unset = disabled). See NEW_PROJECT_SETUP.md Section 4 —
# coordinate with maxify-proj so the same warmer isn't enabled
# in both projects at once.
# ============================================================
BREVO_TEST_WARMER=
BREVO_SEEDLIST_WARMER=
HUBSPOT_TEST_WARMER=
HUBSPOT_SEEDLIST_WARMER=
MAILCHIMP_TEST_WARMER=
MAILCHIMP_SEEDLIST_WARMER=
ACTIVECAMPAIGN_TEST_WARMER=
ACTIVECAMPAIGN_SEEDLIST_WARMER=
MAILERLITE_TEST_WARMER=
MAILERLITE_SEEDLIST_WARMER=

# ============================================================
# Optional — only needed if using Rollbar for error logging
# in services/cronJobs.js (copy from maxify-proj if reusing
# the same Rollbar project, otherwise leave blank to fall
# back to console.error)
# ============================================================
ROLLBAR_ACCESS_TOKEN=

# ============================================================
# AWS SES — email sender service
# Required to use the /dashboard send button.
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# The verified SES sender address (must be verified in your AWS SES account).
# This also needs to match TARGET_SENDERS in engage-test-ses.js so the
# engagement cron recognises the emails and engages with them.
SES_FROM_EMAIL=

# URL placed inside the test email as a clickable link.
# Defaults to https://www.google.com if not set.
SES_CAMPAIGN_CLICK_URL=https://www.google.com

# Max parallel SES sends (default 5 — increase once out of SES sandbox).
SES_SEND_CONCURRENCY=5

# How many seedlist recipients a campaign sends to per run is not a setting:
# it is the sender mailbox's template share of its daily number (the
# organization's Warmup Preference), see services/dailyQuota.js.

# ============================================================
# SMTP campaign transport — sends a template from a warmup
# mailbox connected via app password on the dashboard
# (organization_warmup_emails, provider 'smtp'). See
# services/smtpEmailSender.js and migrations/011.
# ============================================================
# Key used by maxify-proj/backend/utils/encryption.js to encrypt
# organization_warmup_emails.smtp_password (hex, 32 bytes). Leave blank to
# reuse ENCRYPTION_KEY above, which is the same value in production.
WARMUP_ENCRYPTION_KEY=

# Delay between consecutive messages from the same SMTP mailbox, in ms
# (default 4000).
SMTP_SEND_DELAY_MS=4000

# ============================================================
# OAuth campaign transport — sends a template from a warmup
# mailbox connected via Google/Outlook OAuth on the dashboard
# (organization_warmup_emails, provider 'google' | 'outlook').
# Sends via the Gmail API / Microsoft Graph with the row's token.
# Token refresh is delegated to maxify-proj/backend's
# POST /api/organizations/:orgId/warmup-emails/:id/refresh-token
# so the OAuth client secrets never need to live here.
# See services/oauthEmailSender.js and migrations/012.
# ============================================================
# Base URL of maxify-proj/backend (default https://api.maxify.co).
MAXIFY_BACKEND_URL=

# Delay between consecutive messages from the same OAuth mailbox, in ms
# (default 4000).
OAUTH_SEND_DELAY_MS=4000

# MAX-1503: send the ms365/outlook share of a campaign (per the org's
# warmup_preferences) to the Outlook seedlist (admin_seedlist_outlook_accounts)
# instead of only the Gmail/Google auto_responder_mailboxes pool. Turn on
# together with the same flag in maxify-proj/backend, which runs the Outlook
# seed engagement cron. Default off.
OUTLOOK_SEEDLIST_ENABLED=false

# ============================================================
# Spam outreach — services/spamOutreach/
# One Gmail mailbox is a spam trap: the sweeper moves its Inbox
# to Spam; each cycle screenshots new Spam, finds who to write to
# at the sending company (GetLeads), and forwards the company's
# own email to them. Setup:
#   1. Run migrations/013_spam_outreach.sql in Supabase.
#   2. node scripts/spam-outreach/import-state.js <old project dir>
#      (if moving from the standalone spam-outreach project).
#   3. Sign in to the mailbox's Gmail once, by hand, on this
#      server (see README_SPAM_OUTREACH.md).
#   4. Fill in the values below, then turn the two jobs on.
# ============================================================
# Cron flags ('true' to enable).
SPAM_OUTREACH_SWEEPER=
SPAM_OUTREACH_CYCLE=

# The trap mailbox, and a Google APP PASSWORD for it (not the
# account password): Google Account → Security → 2-Step
# Verification → App passwords. Used for IMAP (sweep, fetch,
# drafts) and SMTP (send).
SPAM_OUTREACH_MAILBOX_EMAIL=
SPAM_OUTREACH_APP_PASSWORD=
# Short label stored with every record (default "mike").
SPAM_OUTREACH_MAILBOX_ID=

# GetLeads.io API key — resolves a sender's domain to the people
# the forward goes to.
SPAM_OUTREACH_GETLEADS_API_KEY=

# Drafts are on unless set to "false"; with SEND_ENABLED=true each
# forward is sent instead of saved to Drafts. Sending is
# irreversible and unattended.
SPAM_OUTREACH_DRAFTS_ENABLED=
SPAM_OUTREACH_SEND_ENABLED=
# Hard cap on sends per cycle (default 5).
SPAM_OUTREACH_MAX_SENDS_PER_CYCLE=5
# New Spam messages captured + looked up per cycle; each costs
# GetLeads credits. Blank = no limit.
SPAM_OUTREACH_MAX_MESSAGES_PER_CYCLE=7
# Contact companies whose mail the sweeper moved into Spam, with
# sweptTemplate (says the screenshot was set up by us).
SPAM_OUTREACH_INCLUDE_SWEPT=
# Display name on sent forwards, e.g. "Mike H".
SPAM_OUTREACH_SENDER_NAME=

# Optional paths. Default: backend/spam-outreach-data/
# (chrome-profile/, screenshots/). The Chrome profile holds the
# Gmail sign-in — keep it private.
SPAM_OUTREACH_DATA_DIR=
SPAM_OUTREACH_CHROME_PROFILE_DIR=
SPAM_OUTREACH_SCREENSHOTS_DIR=

PORT=3000
NODE_ENV=development
